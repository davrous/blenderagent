#!/usr/bin/env bash
#
# blenderagent — build and run the Blender scene agent container.
#
# macOS / Linux counterpart of blenderagent.ps1 (and works in Git Bash on
# Windows). Both accept the same verbs, so the muscle memory is identical on
# either OS:
#
#     ./blenderagent rebuild     # docker build
#     ./blenderagent start       # docker run
#     ./blenderagent up          # rebuild, then start
#     ./blenderagent playground  # M365 Agents Playground, pointed at the container
#
# Anything after the verb is passed straight through to docker, e.g.
#
#     ./blenderagent rebuild --no-cache
#     ./blenderagent start -e LOG_LEVEL=DEBUG
#
set -euo pipefail

IMAGE="blender-scene-agent"
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

DIM="$(printf '\033[2m')"
YELLOW="$(printf '\033[33m')"
RESET="$(printf '\033[0m')"

usage() {
    cat <<EOF
blenderagent — build and run the Blender scene agent container

  ./blenderagent rebuild    [docker args]   Build the image ($IMAGE)
  ./blenderagent start      [docker args]   Run it on http://localhost:8088
  ./blenderagent up         [docker args]   Rebuild, then start
  ./blenderagent playground [pg args]       Open the M365 Agents Playground
  ./blenderagent help                       This message

Examples
  ./blenderagent rebuild --no-cache
  ./blenderagent start -e LOG_LEVEL=DEBUG

The container must already be running (in another terminal) before 'playground'.
Playground uses a LAN IPv4 address for Docker replies; use only on a trusted network.
Use 'playground --host <LAN-IP> --port <port>' to override its address or port.
EOF
}

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

assert_docker() {
    command -v docker >/dev/null 2>&1 ||
        die "docker was not found on PATH. Install Docker Desktop and make sure it is running."
}

run_docker() {
    printf '%s> docker %s%s\n' "$DIM" "$*" "$RESET"
    docker "$@"
}

rebuild() {
    assert_docker
    # --platform linux/amd64 is required: the image is built for the Foundry
    # hosted-agent runtime, so an Apple Silicon host must cross-build rather
    # than produce an arm64 image that will not run once deployed.
    run_docker build --platform linux/amd64 -t "$IMAGE" "$@" .
}

start() {
    assert_docker

    [ -f "$ROOT/.env" ] ||
        die ".env not found in $ROOT. Copy .env.example to .env and fill it in first."

    # Local Docker has no Azure Instance Metadata Service. Keep tracing enabled,
    # but omit the azure_vm resource detector that would probe 169.254.169.254.
    local resource_detectors="${OTEL_EXPERIMENTAL_RESOURCE_DETECTORS:-otel,host,os,process,service_instance}"

    # Mounted read-only so the container's DefaultAzureCredential can reuse the
    # `az login` tokens from the host instead of needing its own sign-in.
    if [ ! -d "$HOME/.azure" ]; then
        printf '%swarning: %s/.azure does not exist — run "az login" first or the agent will fail to authenticate.%s\n' \
            "$YELLOW" "$HOME" "$RESET" >&2
    fi

    run_docker run -it --rm \
        -p 8088:8088 \
        -p 8089:8089 \
        --env-file .env \
        -e "OTEL_EXPERIMENTAL_RESOURCE_DETECTORS=$resource_detectors" \
        -e APPLICATIONINSIGHTS_STATSBEAT_DISABLED_ALL=true \
        -v "$HOME/.azure:/root/.azure:ro" \
        "$@" "$IMAGE"
}

playground() {
    command -v agentsplayground >/dev/null 2>&1 ||
        die "agentsplayground was not found on PATH. Install it with 'winget install agentsplayground' (Windows) or see the M365 Agents Playground docs."
    command -v node >/dev/null 2>&1 ||
        die "node was not found on PATH. Install Node.js to select the Playground's Docker-reachable address."

    local defaults
    defaults="$(node "$ROOT/devTools/playground_args.mjs" "$@")" || exit "$?"
    local arguments=()
    if [ -n "$defaults" ]; then
        while IFS= read -r argument; do
            arguments+=("$argument")
        done <<< "$defaults"
    fi
    arguments+=("$@")

    # The Playground only drives an already-running agent; it does not start one.
    if ! curl -fsS -o /dev/null --max-time 2 "http://localhost:8088/readiness"; then
        printf '%swarning: the agent is not ready on http://localhost:8088 — wait for startup or run "./blenderagent start" in another terminal first.%s\n' \
            "$YELLOW" "$RESET" >&2
    fi

    printf '%s> agentsplayground %s%s\n' "$DIM" "${arguments[*]}" "$RESET"
    agentsplayground "${arguments[@]}"
}

cd "$ROOT"

command="${1:-help}"
[ $# -gt 0 ] && shift || true

case "$command" in
rebuild) rebuild "$@" ;;
start) start "$@" ;;
up)
    rebuild "$@"
    start "$@"
    ;;
playground) playground "$@" ;;
help | -h | --help) usage ;;
*)
    printf 'error: unknown command %s\n\n' "$command" >&2
    usage >&2
    exit 1
    ;;
esac
